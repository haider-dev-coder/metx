{
  "expo": {
    "name": "Metx",
    "slug": "metx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "metx",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/logo.png",
      "bundleIdentifier": "com.burakorkmez.metx",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "9NSCVL7862"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.burakorkmez.metx"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/logo.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@clerk/expo",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos and videos for your Metx posts, stories, and profile.",
          "cameraPermission": "Take photos for your Metx posts and stories.",
          "microphonePermission": false
        }
      ],
      "expo-video",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "metx",
          "organization": "codesistency-gs"
        }
      ],
      "@sentry/react-native",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9b157fe4-22cd-40a3-b7d2-3fda96729065"
      }
    },
    "owner": "haiderfareed2323"
  }
}
